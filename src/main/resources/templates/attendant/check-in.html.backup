<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/web/thymeleaf/layout"
      layout:decorate="~{layout}">
<head>
    <title>Patient Check-in - Attendant</title>
    <style>
        .patient-card {
            background: #e3f2fd;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #2196F3;
            margin-bottom: 20px;
        }
        .new-patient-form {
            background: #fff3cd;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #ffc107;
            margin-bottom: 20px;
        }
        #patientDetails, #newPatientForm {
            display: none;
        }
    </style>
</head>
<body>
<div layout:fragment="content">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">Patient Check-in</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a th:href="@{/dashboard}">Dashboard</a></li>
                        <li class="breadcrumb-item active">Check-in</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">

            <!-- Messages -->
            <div id="messageBox"></div>

            <!-- Quick Actions -->
            <div class="row mb-3">
                <div class="col-12">
                    <a th:href="@{/attendant/queue}" class="btn btn-primary">
                        <i class="fas fa-list mr-2"></i>View Live Queue
                    </a>
                </div>
            </div>

            <!-- Book Appointment Card -->
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-calendar-plus mr-2"></i>Book Appointment</h3>
                </div>
                <div class="card-body">

                    <!-- Step 1: Phone Number Entry -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Patient Phone Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="tel" id="phoneNumber" class="form-control"
                                           placeholder="Enter 10-digit phone number"
                                           pattern="[0-9]{10}" maxlength="10" required/>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-info" onclick="searchPatient()">
                                            <i class="fas fa-search"></i> Search
                                        </button>
                                    </div>
                                </div>
                                <small class="form-text text-muted">Enter phone number to check if patient exists</small>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Existing Patient Details -->
                    <div id="patientDetails" class="patient-card">
                        <h5><i class="fas fa-user-check mr-2 text-success"></i>Patient Found!</h5>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <strong>Name:</strong> <span id="patientName"></span>
                            </div>
                            <div class="col-md-4">
                                <strong>Patient ID:</strong> <span id="patientIdDisplay"></span>
                            </div>
                            <div class="col-md-4">
                                <strong>Gender:</strong> <span id="patientGender"></span>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-4">
                                <strong>DOB:</strong> <span id="patientDOB"></span>
                            </div>
                            <div class="col-md-4">
                                <strong>Phone:</strong> <span id="patientPhone"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2 Alternative: Multiple Patients Selection -->
                    <div id="multiplePatientsSection" style="display:none;">
                        <div class="alert alert-warning">
                            <h5><i class="fas fa-exclamation-triangle mr-2"></i>Multiple Patients Found with this Phone Number</h5>
                            <p>Please select the correct patient:</p>
                        </div>
                        <div id="patientsList" class="row"></div>
                    </div>

                    <!-- Step 2 Alternative: New Patient Form -->
                    <div id="newPatientForm" class="new-patient-form">
                        <h5><i class="fas fa-user-plus mr-2 text-warning"></i>New Patient - Register</h5>
                        <div class="row mt-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>First Name <span class="text-danger">*</span></label>
                                    <input type="text" id="firstName" class="form-control" required/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Last Name <span class="text-danger">*</span></label>
                                    <input type="text" id="lastName" class="form-control" required/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Gender <span class="text-danger">*</span></label>
                                    <select id="gender" class="form-control" required>
                                        <option value="">Select</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Date of Birth <span class="text-danger">*</span></label>
                                    <input type="date" id="dateOfBirth" class="form-control" required/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Email (Optional)</label>
                                    <input type="email" id="email" class="form-control"/>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Address (Optional)</label>
                                    <input type="text" id="address" class="form-control"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Appointment Details -->
                    <div id="appointmentSection" style="display:none;">
                        <hr/>
                        <h5><i class="fas fa-calendar-check mr-2"></i>Appointment Details</h5>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Doctor <span class="text-danger">*</span></label>
                                    <select id="doctorId" class="form-control" required>
                                        <option value="">-- Select Doctor --</option>
                                        <option th:each="doctor : ${doctors}"
                                                th:value="${doctor.id}"
                                                th:text="${doctor.firstName} + ' ' + ${doctor.lastName} + ' - ' + ${doctor.specialization}">
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Appointment Date <span class="text-danger">*</span></label>
                                    <input type="date" id="appointmentDate" class="form-control"
                                           th:value="${today}" required/>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle mr-2"></i>
                            Queue number and time will be assigned automatically
                        </div>

                        <button type="button" class="btn btn-success btn-lg" onclick="bookAppointment()">
                            <i class="fas fa-check mr-2"></i>Book Appointment
                        </button>
                        <button type="button" class="btn btn-secondary btn-lg" onclick="resetForm()">
                            <i class="fas fa-undo mr-2"></i>Reset
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </section>
</div>

<th:block layout:fragment="scripts">
<script th:inline="javascript">
    let currentPatientId = null;
    const csrfToken = /*[[${_csrf.token}]]*/ '';
    const csrfHeader = /*[[${_csrf.headerName}]]*/ '';

    function searchPatient() {
        const phone = document.getElementById('phoneNumber').value.trim();

        if (!phone || phone.length !== 10) {
            showMessage('Please enter a valid 10-digit phone number', 'warning');
            return;
        }

        // Search for patient by phone
        fetch(`/api/patients/search-by-phone?phone=${phone}`, {
            headers: {
                [csrfHeader]: csrfToken
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.found) {
                if (data.multiple) {
                    // Multiple patients found - show selection
                    showMultiplePatients(data.patients);
                } else {
                    // Single patient - show details
                    showExistingPatient(data.patient);
                }
            } else {
                // Patient not found - show registration form
                showNewPatientForm();
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showMessage('Error searching patient. Please try again.', 'danger');
        });
    }

    function showMultiplePatients(patients) {
        currentPatientId = null;

        document.getElementById('patientDetails').style.display = 'none';
        document.getElementById('newPatientForm').style.display = 'none';
        document.getElementById('multiplePatientsSection').style.display = 'block';
        document.getElementById('appointmentSection').style.display = 'none';

        const patientsList = document.getElementById('patientsList');
        patientsList.innerHTML = '';

        patients.forEach(patient => {
            const card = `
                <div class="col-md-6 mb-3">
                    <div class="card" style="cursor:pointer; border: 2px solid #ddd;" onclick="selectPatient(${patient.id}, '${patient.firstName}', '${patient.lastName}', '${patient.patientId}', '${patient.gender}', '${patient.dateOfBirth}', '${patient.phoneNumber}')">
                        <div class="card-body">
                            <h5 class="card-title">${patient.firstName} ${patient.lastName}</h5>
                            <p class="card-text mb-1"><strong>Patient ID:</strong> ${patient.patientId || 'N/A'}</p>
                            <p class="card-text mb-1"><strong>Gender:</strong> ${patient.gender || 'N/A'}</p>
                            <p class="card-text mb-1"><strong>DOB:</strong> ${patient.dateOfBirth || 'N/A'}</p>
                            <button class="btn btn-primary btn-sm mt-2">Select This Patient</button>
                        </div>
                    </div>
                </div>
            `;
            patientsList.innerHTML += card;
        });

        showMessage(`${patients.length} patients found with this phone number. Please select one.`, 'info');
    }

    function selectPatient(id, firstName, lastName, patientId, gender, dob, phone) {
        const patient = {
            id: id,
            firstName: firstName,
            lastName: lastName,
            patientId: patientId,
            gender: gender,
            dateOfBirth: dob,
            phoneNumber: phone
        };

        document.getElementById('multiplePatientsSection').style.display = 'none';
        showExistingPatient(patient);
    }

    function showExistingPatient(patient) {
        currentPatientId = patient.id;

        document.getElementById('patientName').textContent = patient.firstName + ' ' + patient.lastName;
        document.getElementById('patientIdDisplay').textContent = patient.patientId || 'N/A';
        document.getElementById('patientGender').textContent = patient.gender || 'N/A';
        document.getElementById('patientDOB').textContent = patient.dateOfBirth || 'N/A';
        document.getElementById('patientPhone').textContent = patient.phoneNumber;

        document.getElementById('patientDetails').style.display = 'block';
        document.getElementById('newPatientForm').style.display = 'none';
        document.getElementById('appointmentSection').style.display = 'block';

        showMessage('Patient found! You can now book an appointment.', 'success');
    }

    function showNewPatientForm() {
        currentPatientId = null;

        document.getElementById('patientDetails').style.display = 'none';
        document.getElementById('newPatientForm').style.display = 'block';
        document.getElementById('appointmentSection').style.display = 'block';

        showMessage('Patient not found. Please fill in the details to register.', 'info');
    }

    function bookAppointment() {
        const doctorId = document.getElementById('doctorId').value;
        const appointmentDate = document.getElementById('appointmentDate').value;

        if (!doctorId || !appointmentDate) {
            showMessage('Please select doctor and appointment date', 'warning');
            return;
        }

        let requestData = {
            doctorId: doctorId,
            appointmentDate: appointmentDate
        };

        // If new patient, create patient first
        if (!currentPatientId) {
            const firstName = document.getElementById('firstName').value.trim();
            const lastName = document.getElementById('lastName').value.trim();
            const gender = document.getElementById('gender').value;
            const dateOfBirth = document.getElementById('dateOfBirth').value;
            const phoneNumber = document.getElementById('phoneNumber').value.trim();
            const email = document.getElementById('email').value.trim();
            const address = document.getElementById('address').value.trim();

            if (!firstName || !lastName || !gender || !dateOfBirth) {
                showMessage('Please fill all required patient fields', 'warning');
                return;
            }

            requestData.newPatient = {
                firstName: firstName,
                lastName: lastName,
                phoneNumber: phoneNumber,
                gender: gender,
                dateOfBirth: dateOfBirth,
                email: email,
                address: address
            };
        } else {
            requestData.patientId = currentPatientId;
        }

        // Book appointment (with or without new patient creation)
        fetch('/attendant/book-appointment-json', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                [csrfHeader]: csrfToken
            },
            body: JSON.stringify(requestData)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showMessage(data.message, 'success');
                setTimeout(() => {
                    resetForm();
                }, 2000);
            } else {
                showMessage(data.message || 'Error booking appointment', 'danger');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showMessage('Error booking appointment. Please try again.', 'danger');
        });
    }

    function resetForm() {
        document.getElementById('phoneNumber').value = '';
        document.getElementById('patientDetails').style.display = 'none';
        document.getElementById('newPatientForm').style.display = 'none';
        document.getElementById('multiplePatientsSection').style.display = 'none';
        document.getElementById('appointmentSection').style.display = 'none';

        document.getElementById('firstName').value = '';
        document.getElementById('lastName').value = '';
        document.getElementById('gender').value = '';
        document.getElementById('dateOfBirth').value = '';
        document.getElementById('email').value = '';
        document.getElementById('address').value = '';
        document.getElementById('doctorId').value = '';

        currentPatientId = null;
        document.getElementById('messageBox').innerHTML = '';
    }

    function showMessage(message, type) {
        const alertClass = 'alert-' + type;
        const html = `<div class="alert ${alertClass} alert-dismissible fade show">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            <i class="icon fas fa-${type === 'success' ? 'check' : type === 'danger' ? 'ban' : 'info-circle'}"></i> ${message}
        </div>`;
        document.getElementById('messageBox').innerHTML = html;
    }

    // Allow Enter key on phone number input
    document.getElementById('phoneNumber').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            searchPatient();
        }
    });
</script>
</th:block>
</body>
</html>

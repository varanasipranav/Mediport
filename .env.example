# Copy to .env and fill in. Never commit .env.

# --- your public address (DNS A/AAAA record must point at this server) ---
DOMAIN=app.example.com

# --- database ---
DB_ROOT_PASSWORD=change-me-long-random
DB_PASSWORD=change-me-long-random

# --- sessions ("keep me signed in") ---
REMEMBER_ME_KEY=generate-with-openssl-rand-base64-32

# --- platform operator (the console at /platform). If blank, a random password is printed once in the app log. ---
PLATFORM_ADMIN_USER=operator
PLATFORM_ADMIN_PASSWORD=

# --- WhatsApp (Meta Cloud API) ---
# One Meta app serves every clinic: its secret verifies webhooks, the verify token is what you type into Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=generate-with-openssl-rand-hex-16
# Optional: a platform-wide number/token used only by the first clinic. Clinics normally have their own (set in the console).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- tuning ---
LOG_LEVEL=INFO
